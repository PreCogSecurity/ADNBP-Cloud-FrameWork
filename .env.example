# =============================================================
# ADNBP Cloud FrameWork - Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# =============================================================

# Google APIs
GOOGLE_PUBLIC_API_CREDENTIAL=your-google-public-api-key
GOOGLE_SERVER_API_CREDENTIAL=your-google-server-api-key

# CloudFrameWork Service Auth
CLOUD_SERVICE_ID=your-cloud-service-id
CLOUD_SERVICE_SECRET=your-cloud-service-secret

# Facebook OAuth
FACEBOOK_OAUTH_APP_ID=your-facebook-app-id
FACEBOOK_OAUTH_APP_SECRET=your-facebook-app-secret

# Twitter OAuth
TWITTER_OAUTH_KEY=your-twitter-consumer-key
TWITTER_OAUTH_SECRET=your-twitter-consumer-secret

# LinkedIn OAuth
LINKEDIN_OAUTH_KEY=your-linkedin-api-key
LINKEDIN_OAUTH_SECRET=your-linkedin-secret

# Pinterest OAuth
PINTEREST_OAUTH_CLIENT_ID=your-pinterest-client-id
PINTEREST_OAUTH_CLIENT_SECRET=your-pinterest-client-secret

# SendGrid Email
SENDGRID_USER=your-sendgrid-username
SENDGRID_PASSWORD=your-sendgrid-password

# Database (CloudSQL)
DB_SERVER=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=cloudframe
DB_PORT=3306
DB_SOCKET=
