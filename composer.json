{
  "name": "precogsecurity/adnbp-cloud-framework",
  "description": "ADNBP Cloud FrameWork for Portals, eCommerce, Social Networks, CRMs and ERPs",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Adrián Martínez Maldonado",
      "email": "am@cloudframework.io"
    },
    {
      "name": "Fran López Quesada",
      "email": "fl@cloudframework.io"
    }
  ],
  "require": {
    "php": ">=7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "CloudFramework\\": "cloudframework_appengine_php/src/",
      "CloudFrameworkTest\\": "cloudframework_appengine_php/tests/"
    }
  },
  "config": {
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit --configuration phpunit.xml.dist",
    "lint": "vendor/bin/phpcs --standard=phpcs.xml",
    "syntax-check": "php -l cloudframework_appengine_php/src/Core.php && php -l cloudframework_appengine_php/src/class/DataStore.php && php -l ADNBP/class/ADNBP.php"
  }
}
